                                                         t, msg_Ca, cid_C, 
                                                         countsUpdated, txnId_, 
                                                         cid_W, mtype, quorom, 
                                                         minority, msg_W, 
                                                         txnId_S, cid, 
                                                         decision, txnId, i1, 
